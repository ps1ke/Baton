{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://baton.invalid/schemas/1/catalog.schema.json",
 "title": "baton catalog (protocol 1)",
 "type": "object",
 "required": ["baton_catalog", "name"],
 "properties": {
  "baton_catalog": {"const": "1"},
  "name": {"type": "string", "minLength": 1, "maxLength": 120},
  "description": {"type": "string"},
  "updated": {"type": "string"},
  "projects": {"type": "array", "maxItems": 5000, "items": {"$ref": "manifest.schema.json"}},
  "catalogs": {"type": "array", "maxItems": 200, "items": {"type": "object", "required": ["url"], "properties": {
    "name": {"type": "string"}, "url": {"type": "string", "maxLength": 500,
      "description": "absolute http(s) URL or path, or relative to this catalog's location"}}}}
 }
}
